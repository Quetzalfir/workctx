{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/claim.schema.json",
  "title": "Temporal claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "subject",
    "predicate",
    "object",
    "observed_at",
    "status",
    "confidence",
    "source_observations"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^CLM-[0-9]{4}-[0-9]{5}$"
    },
    "subject": {
      "type": "string",
      "pattern": "^workctx://.+$"
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object": {},
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "current",
        "superseded",
        "retracted",
        "uncertain"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "source_observations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
