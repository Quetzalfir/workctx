{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/secret-scan-acknowledgments.schema.json",
  "title": "Secret scan acknowledgments",
  "description": "Canonical schema_version 1 record for explicit operator acknowledgment of exact-content possible-secret findings. Draft 2020-12 validation is necessary but not sufficient. Producer invariants require case-insensitive path uniqueness, a non-empty entry set, exact SHA-256 hashes of acknowledged file bytes, UTC timestamps, and creation or update only inside the same audited transaction as the acknowledged postimages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acknowledgments"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "acknowledgments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/acknowledgment"
      }
    }
  },
  "$defs": {
    "context_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!/)(?:[^\\u0000-\\u001f/\\\\]+/)*[^\\u0000-\\u001f/\\\\]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "(?:^|/)\\.\\.?(?:/|$)"
          },
          {
            "pattern": ":"
          },
          {
            "pattern": "(?:^|/)[^/]*[. ](?:/|$)"
          },
          {
            "pattern": "(?:^|/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][lL][oO][cC][kK]\\$|[cC][oO][nN][iI][nN]\\$|[cC][oO][nN][oO][uU][tT]\\$|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.[^/]*)?(?:/|$)"
          },
          {
            "pattern": "^[9][9]_[mM][eE][tT][aA]/[sS][eE][cC][rR][eE][tT]-[sS][cC][aA][nN]-[aA][cC][kK][nN][oO][wW][lL][eE][dD][gG][mM][eE][nN][tT][sS]\\.[yY][aA][mM][lL]$"
          }
        ]
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "acknowledgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_hash",
        "acknowledged_at"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/context_relative_path"
        },
        "content_hash": {
          "$ref": "#/$defs/content_hash"
        },
        "acknowledged_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
