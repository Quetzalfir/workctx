{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/suggestion-record.schema.json",
  "title": "Canonical suggestion record",
  "description": "A closed suggestion frontmatter contract stored under 03_work/suggestions. Draft 2020-12 validation is necessary but not sufficient. The schema requires a data-fix proposal to be present and to require approval. Producer invariants enforced by the model and service are: the suggestion ID date equals created_at in UTC; the investigation URI context and ID equal the record identity; updated_at does not precede created_at; a data-fix proposal has the same context and actor as the record; supersession links are non-self-referential and reciprocal across preserved records; and lifecycle mutations use the current verified ledger revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "entity_type",
    "title",
    "uri",
    "aliases",
    "status",
    "confidence",
    "tags",
    "references",
    "created_at",
    "updated_at",
    "type",
    "rationale",
    "signal",
    "source_refs",
    "proposal",
    "actor",
    "supersedes",
    "superseded_by"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/suggestion_id"
    },
    "entity_type": {
      "const": "investigation"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "uri": {
      "type": "string",
      "pattern": "^workctx://[a-z0-9]+(?:-[a-z0-9]+)*/investigation/SUG-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{2}$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "open",
        "adopted",
        "rejected",
        "superseded"
      ]
    },
    "confidence": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "low",
        "medium",
        "high",
        null
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "reference.schema.json"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "enum": [
        "data_fix",
        "skill_override",
        "engine_proposal"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\r\\n\\u0000-\\u001f\\u007f]+$"
    },
    "signal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^\\r\\n\\u0000-\\u001f\\u007f]+$"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "transaction-proposal.schema.json#/$defs/durable_reference"
      },
      "uniqueItems": true
    },
    "proposal": {
      "oneOf": [
        {
          "$ref": "transaction-proposal.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "transaction-proposal.schema.json#/$defs/actor"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SUG-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{2}$"
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SUG-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{2}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "data_fix"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "proposal": {
            "allOf": [
              {
                "$ref": "transaction-proposal.schema.json"
              },
              {
                "properties": {
                  "approval": {
                    "const": "required"
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "proposal": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "superseded_by": {
            "$ref": "#/$defs/suggestion_id"
          }
        }
      },
      "else": {
        "properties": {
          "superseded_by": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "suggestion_id": {
      "type": "string",
      "pattern": "^SUG-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{2}$"
    }
  }
}
