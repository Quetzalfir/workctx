{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/skill-registry.schema.json",
  "title": "Canonical skill side-effect registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "side_effect_class"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 80
        },
        "side_effect_class": {
          "enum": [
            "read_only",
            "local_proposal",
            "local_mutation",
            "external_read",
            "external_write"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "side_effect_class": {
                "const": "external_write"
              }
            },
            "required": [
              "side_effect_class"
            ]
          },
          "then": {
            "required": [
              "notes"
            ],
            "properties": {
              "notes": {
                "pattern": "^(?:[Rr]equires? [Ee]xplicit [Aa]pproval|[Ee]xplicit [Aa]pproval (?:is )?[Rr]equired)\\b"
              }
            }
          }
        }
      ]
    }
  }
}
