{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/artifact-manifest.schema.json",
  "title": "Artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "content_hash",
    "original_name",
    "media_type",
    "source_type",
    "ingested_at",
    "status",
    "preserved_path"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^ART-[0-9]{8}-[a-z0-9-]+-[0-9]{2}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "original_name": {
      "type": "string",
      "minLength": 1
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "chat",
        "meeting",
        "transcript",
        "screenshot",
        "image",
        "document",
        "spreadsheet",
        "audio",
        "video",
        "email",
        "note",
        "repository",
        "external_snapshot",
        "other"
      ]
    },
    "source_origin": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "event_at_inferred": {
      "type": "boolean",
      "default": false
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "classification": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        null
      ]
    },
    "status": {
      "enum": [
        "pending",
        "quarantined",
        "processing",
        "processed",
        "failed",
        "duplicate"
      ]
    },
    "preserved_path": {
      "type": "string",
      "minLength": 1
    },
    "sidecars": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duplicate_of": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ART-[0-9]{8}-[a-z0-9-]+-[0-9]{2}$"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
