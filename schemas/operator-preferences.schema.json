{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/operator-preferences.schema.json",
  "title": "Local operator preferences",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "display_name",
    "interaction_language",
    "repository_language"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "interaction_language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "repository_language": {
      "type": "string",
      "const": "en"
    }
  }
}
