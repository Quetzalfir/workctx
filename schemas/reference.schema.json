{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/reference.schema.json",
  "title": "Typed reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relation",
    "target"
  ],
  "properties": {
    "relation": {
      "enum": [
        "derived_from",
        "evidenced_by",
        "supports",
        "contradicts",
        "supersedes",
        "parent_of",
        "depends_on",
        "blocks",
        "requested_by",
        "owned_by",
        "waiting_on",
        "produces",
        "implements",
        "calls",
        "publishes_to",
        "consumes_from",
        "stores_in",
        "authenticates_via",
        "operated_by",
        "affects",
        "mentions",
        "related_to"
      ]
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9+.-]*://.+$",
      "not": {
        "pattern": "^file://"
      },
      "allOf": [
        {
          "if": {
            "pattern": "^workctx://"
          },
          "then": {
            "pattern": "^workctx://[a-z0-9]+(?:-[a-z0-9]+)*/(?:evidence|person|team|project|system|service|module|flow|integration|decision|risk|question|task|claim|draft|investigation|incident|observation|artifact)/(?:[A-Za-z0-9._~-]|%[0-9A-F]{2})+$"
          }
        },
        {
          "if": {
            "pattern": "^artifact://"
          },
          "then": {
            "pattern": "^artifact://sha256/[0-9a-f]{64}$"
          }
        },
        {
          "if": {
            "pattern": "^repo://"
          },
          "then": {
            "pattern": "^repo://[a-z0-9]+(?:[._-][a-z0-9]+)*@[0-9a-fA-F]{7,64}/(?:[A-Za-z0-9._~-]|%[0-9A-F]{2})+(?:/(?:[A-Za-z0-9._~-]|%[0-9A-F]{2})+)*#L[1-9][0-9]*-L[1-9][0-9]*$"
          }
        }
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "source_observations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "note": {
      "type": "string"
    }
  }
}
