{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/entity.schema.json",
  "title": "Canonical entity metadata",
  "description": "Canonical entity metadata. Producer invariant: each topics value is a unique kebab-case slug that must resolve through 99_meta/topics.yaml to an active topic slug or an alias of an active topic; JSON Schema cannot perform that registry lookup.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "entity_type",
    "title",
    "uri",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "enum": [
        "evidence",
        "person",
        "team",
        "project",
        "system",
        "service",
        "module",
        "flow",
        "integration",
        "decision",
        "risk",
        "question",
        "task",
        "claim",
        "draft",
        "investigation",
        "incident",
        "observation",
        "artifact"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "pattern": "^workctx://[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*/(?!(?:\\.|%2[eE]){1,2}$)[^/?#]+$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "low",
        "medium",
        "high",
        null
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "minLength": 1,
        "maxLength": 100
      },
      "uniqueItems": true,
      "description": "Optional durable-subject facets. Absent or empty means the shared common layer. Producer invariant: values resolve to active registry slugs or aliases."
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "reference.schema.json"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
