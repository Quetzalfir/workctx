{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/entity.schema.json",
  "title": "Canonical entity metadata",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "entity_type",
    "title",
    "uri",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "enum": [
        "evidence",
        "person",
        "team",
        "project",
        "system",
        "service",
        "module",
        "flow",
        "integration",
        "decision",
        "risk",
        "question",
        "task",
        "claim",
        "draft",
        "investigation",
        "incident"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "pattern": "^workctx://[a-z0-9-]+/[a-z0-9-]+/.+$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "reference.schema.json"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
