{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/checkpoint.schema.json",
  "title": "Canonical session checkpoint",
  "description": "Content-free canonical item revisions used for deterministic staleness checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "created_at",
    "label",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^CHK-[0-9]{8}T[0-9]{6}Z-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{8}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n\\u0000-\\u001f\\u007f]+$"
    },
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 100
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "source_path",
        "content_hash"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^workctx://[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*/(?:[A-Za-z0-9._~-]|%[0-9A-F]{2})+$"
        },
        "source_path": {
          "type": "string",
          "pattern": "^(?:02_knowledge|03_work|05_outbox)/(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)[^\\u0000-\\u001f]+$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
