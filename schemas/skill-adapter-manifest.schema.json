{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/skill-adapter-manifest.schema.json",
  "title": "Agent adapter manifest",
  "description": "Schema validation is necessary but not sufficient. Producers and consumers must also enforce semantic relations that portable JSON Schema cannot compare directly: each canonical path is derived from its skill name; each native-verified source set belongs to that skill, contains the canonical path/hash pair exactly once, has unique Unicode-NFC/full-case-fold path keys, and has the declared aggregate hash; generated paths have unique collision keys and belong to the selected adapter; the instruction bridge source and target map to the selected adapter; generated bridge source and target hashes match; implemented MCP configuration paths map to the selected adapter; each backup timestamp directory corresponds to created_at; and all declared paths pass the no-follow filesystem rules in the reference contract. In native-verified mode, canonical is the primary native path/hash verification record, source_set covers every file in the canonical skill directory, and generated is absent. When components is present, it contains exactly one instruction_bridge and one mcp_configuration. An implemented MCP record has state generated, native, or divergent plus an exact path and content hash; the legacy not_implemented state carries neither. New producers must explicitly set every skill mode and emit components and backups. Their omission is accepted only to read legacy generated manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter",
    "adapter_version",
    "scope",
    "generated_at",
    "registry",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "adapter": {
      "enum": [
        "codex",
        "claude",
        "gemini"
      ]
    },
    "adapter_version": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "const": "project"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "registry": {
      "$ref": "#/$defs/registrySource"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/skillAdapter"
      }
    },
    "components": {
      "$ref": "#/$defs/adapterComponents"
    },
    "backups": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/backupEntry"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter": {
            "const": "codex"
          }
        },
        "required": [
          "adapter"
        ]
      },
      "then": {
        "properties": {
          "skills": {
            "items": {
              "properties": {
                "generated": {
                  "items": {
                    "properties": {
                      "path": {
                        "pattern": "^(?:\\.codex/|\\.agents/skills/[a-z0-9-]+/SKILL\\.md$)"
                      }
                    }
                  }
                }
              }
            }
          },
          "components": {
            "properties": {
              "instruction_bridge": {
                "properties": {
                  "source": {
                    "properties": {
                      "path": {
                        "const": "AGENTS.md"
                      }
                    }
                  },
                  "target": {
                    "properties": {
                      "path": {
                        "const": "AGENTS.md"
                      }
                    }
                  }
                }
              },
              "mcp_configuration": {
                "properties": {
                  "path": {
                    "const": ".codex/config.toml"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "adapter": {
            "const": "claude"
          }
        },
        "required": [
          "adapter"
        ]
      },
      "then": {
        "properties": {
          "skills": {
            "items": {
              "properties": {
                "generated": {
                  "items": {
                    "properties": {
                      "path": {
                        "pattern": "^\\.claude/"
                      }
                    }
                  }
                }
              }
            }
          },
          "components": {
            "properties": {
              "instruction_bridge": {
                "properties": {
                  "source": {
                    "properties": {
                      "path": {
                        "const": "CLAUDE.md"
                      }
                    }
                  },
                  "target": {
                    "properties": {
                      "path": {
                        "const": "CLAUDE.md"
                      }
                    }
                  }
                }
              },
              "mcp_configuration": {
                "properties": {
                  "path": {
                    "const": ".mcp.json"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "adapter": {
            "const": "gemini"
          }
        },
        "required": [
          "adapter"
        ]
      },
      "then": {
        "properties": {
          "skills": {
            "items": {
              "properties": {
                "generated": {
                  "items": {
                    "properties": {
                      "path": {
                        "pattern": "^\\.gemini/"
                      }
                    }
                  }
                }
              }
            }
          },
          "components": {
            "properties": {
              "instruction_bridge": {
                "properties": {
                  "source": {
                    "properties": {
                      "path": {
                        "const": "GEMINI.md"
                      }
                    }
                  },
                  "target": {
                    "properties": {
                      "path": {
                        "const": "GEMINI.md"
                      }
                    }
                  }
                }
              },
              "mcp_configuration": {
                "properties": {
                  "path": {
                    "const": ".gemini/settings.json"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generatedPath": {
      "type": "string",
      "pattern": "^\\.(?:codex|claude|gemini)/(?!\\.\\.?(?:/|$))(?!.*(?:/\\.\\.?)(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "managedPath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*(?:/\\.\\.?)(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "backupPath": {
      "type": "string",
      "pattern": "^\\.workctx/backups/[0-9]{8}T[0-9]{6}(?:\\.[0-9]+)?Z/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "registrySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_hash"
      ],
      "properties": {
        "path": {
          "const": ".agents/skills/registry.yaml"
        },
        "content_hash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "canonicalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.agents/skills/[a-z0-9]+(?:-[a-z0-9]+)*/SKILL\\.md$"
        },
        "content_hash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "nativeSourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.agents/skills/[a-z0-9]+(?:-[a-z0-9]+)*/(?!\\.\\.?(?:/|$))(?!.*(?:/\\.\\.?)(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "content_hash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "nativeSourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "aggregate_hash"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nativeSourceFile"
          }
        },
        "aggregate_hash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "generatedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_hash"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/generatedPath"
        },
        "content_hash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "skillAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "canonical"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 80
        },
        "mode": {
          "enum": [
            "generated",
            "native-verified"
          ]
        },
        "canonical": {
          "$ref": "#/$defs/canonicalSource"
        },
        "source_set": {
          "$ref": "#/$defs/nativeSourceSet"
        },
        "generated": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/generatedFile"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "generated"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "mode"
                ]
              },
              {
                "required": [
                  "source_set"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "generated"
            }
          },
          "required": [
            "mode",
            "generated"
          ],
          "not": {
            "required": [
              "source_set"
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "native-verified"
            }
          },
          "required": [
            "mode",
            "source_set"
          ],
          "not": {
            "required": [
              "generated"
            ]
          }
        }
      ]
    },
    "bridgeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_hash"
      ],
      "properties": {
        "path": {
          "enum": [
            "AGENTS.md",
            "CLAUDE.md",
            "GEMINI.md"
          ]
        },
        "content_hash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "bridgeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_hash"
      ],
      "properties": {
        "path": {
          "enum": [
            "AGENTS.md",
            "CLAUDE.md",
            "GEMINI.md"
          ]
        },
        "content_hash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "instructionBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership",
        "source",
        "target"
      ],
      "properties": {
        "ownership": {
          "enum": [
            "generated",
            "user-owned"
          ]
        },
        "source": {
          "$ref": "#/$defs/bridgeSource"
        },
        "target": {
          "$ref": "#/$defs/bridgeTarget"
        }
      }
    },
    "mcpConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_implemented",
            "generated",
            "native",
            "divergent"
          ]
        },
        "path": {
          "enum": [
            ".codex/config.toml",
            ".mcp.json",
            ".gemini/settings.json"
          ]
        },
        "content_hash": {
          "$ref": "#/$defs/contentHash"
        }
      },
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "not_implemented"
            }
          },
          "required": [
            "state"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "content_hash"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "state": {
              "enum": [
                "generated",
                "native",
                "divergent"
              ]
            }
          },
          "required": [
            "state",
            "path",
            "content_hash"
          ]
        }
      ]
    },
    "adapterComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction_bridge",
        "mcp_configuration"
      ],
      "properties": {
        "instruction_bridge": {
          "$ref": "#/$defs/instructionBridge"
        },
        "mcp_configuration": {
          "$ref": "#/$defs/mcpConfiguration"
        }
      }
    },
    "backupEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_path",
        "path",
        "content_hash",
        "created_at"
      ],
      "properties": {
        "original_path": {
          "$ref": "#/$defs/managedPath"
        },
        "path": {
          "$ref": "#/$defs/backupPath"
        },
        "content_hash": {
          "$ref": "#/$defs/contentHash"
        },
        "created_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    }
  }
}
