{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/audit-event.schema.json",
  "title": "Audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "context_id",
    "timestamp",
    "actor",
    "action",
    "result",
    "source_refs",
    "target_refs",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "context_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object"
    },
    "action": {
      "type": "string"
    },
    "result": {
      "enum": [
        "success",
        "rejected",
        "failed",
        "partial_projection_failure"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "previous_event_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "type": "object"
    }
  }
}
