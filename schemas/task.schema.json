{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/task.schema.json",
  "title": "Task entity",
  "allOf": [
    {
      "$ref": "entity.schema.json"
    },
    {
      "type": "object",
      "required": [
        "task_type",
        "root_task",
        "priority",
        "status",
        "next_action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TASK-[0-9]{4}-[0-9]{3}(?:-ST[0-9]{2})?$"
        },
        "entity_type": {
          "const": "task"
        },
        "task_type": {
          "enum": [
            "parent",
            "subtask"
          ]
        },
        "parent_task": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^TASK-[0-9]{4}-[0-9]{3}$"
        },
        "root_task": {
          "type": "string",
          "pattern": "^TASK-[0-9]{4}-[0-9]{3}$"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3",
            "P4"
          ]
        },
        "status": {
          "enum": [
            "backlog",
            "ready",
            "active",
            "blocked",
            "waiting",
            "done",
            "cancelled"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "requester": {
          "type": [
            "string",
            "null"
          ]
        },
        "waiting_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "due_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source_observations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "task_type": {
                "const": "parent"
              }
            },
            "required": [
              "task_type"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^TASK-[0-9]{4}-[0-9]{3}$"
              },
              "parent_task": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": {
                "const": "subtask"
              }
            },
            "required": [
              "task_type"
            ]
          },
          "then": {
            "required": [
              "parent_task"
            ],
            "properties": {
              "id": {
                "pattern": "^TASK-[0-9]{4}-[0-9]{3}-ST[0-9]{2}$"
              },
              "parent_task": {
                "type": "string",
                "pattern": "^TASK-[0-9]{4}-[0-9]{3}$"
              }
            }
          }
        }
      ]
    }
  ]
}
