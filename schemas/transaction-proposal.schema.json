{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/transaction-proposal.schema.json",
  "title": "Transaction proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "context_id",
    "base_revision",
    "actor",
    "created_at",
    "source_refs",
    "operations",
    "preconditions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^TXP-[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$"
    },
    "context_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "agent",
            "system"
          ]
        },
        "id": {
          "type": "string"
        },
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "target",
          "payload"
        ],
        "properties": {
          "op": {
            "enum": [
              "create",
              "update",
              "move",
              "delete_generated",
              "append_audit"
            ]
          },
          "target": {
            "type": "string"
          },
          "payload": {},
          "expected_hash": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "approval": {
      "enum": [
        "not_required",
        "required",
        "granted",
        "denied"
      ]
    }
  }
}
