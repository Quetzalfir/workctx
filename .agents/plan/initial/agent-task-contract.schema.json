{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workctx.dev/schemas/agent-task-contract.schema.json",
  "title": "Agent work-order contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "objective",
    "scope",
    "non_goals",
    "base_commit",
    "allowed_paths",
    "forbidden_paths",
    "required_reading",
    "deliverables",
    "acceptance_criteria",
    "validation_commands",
    "report_paths"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^WP-[0-9]{3}(?:-[A-Za-z0-9-]+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "ready",
        "assigned",
        "in_progress",
        "reported",
        "review_required",
        "accepted",
        "revision_requested",
        "rejected",
        "integrated",
        "verified",
        "closed"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "business_value": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "base_commit": {
      "type": "string",
      "minLength": 7
    },
    "branch": {
      "type": "string"
    },
    "worktree": {
      "type": "string"
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_reading": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "security_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markdown",
        "json"
      ],
      "properties": {
        "markdown": {
          "type": "string"
        },
        "json": {
          "type": "string"
        }
      }
    }
  }
}
